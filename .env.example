# Copy to .env and fill in. Never commit the real .env.
#
# Generate a signing key (32+ bytes). Any of these work:
#   openssl rand -base64 48
#   powershell -c "[Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))"

POSTGRES_DB=casino
POSTGRES_USER=casino
POSTGRES_PASSWORD=change-me-before-running

# Must be at least 32 bytes. The backend refuses to start without it outside the dev profile.
CASINO_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# "prod" enforces the strict configuration. Use "dev" for verbose logging and a generated
# ephemeral JWT key.
SPRING_PROFILES_ACTIVE=prod
